# =====================================================================
# Vórtex Suporte — variáveis de ambiente
# Copie este arquivo para .env.local (no seu computador) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# NUNCA coloque o .env.local no git.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (obrigatório) — Project Settings > API (ou API Keys) no painel do Supabase
# ---------------------------------------------------------------------
# Endereço do seu projeto (Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...). Pode ir pro navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
# Chave SECRETA: "service_role" (legada) ou "secret" (sb_secret_...). Nunca mostre pra ninguém.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role-ou-secret

# ---------------------------------------------------------------------
# Endereço do sistema e do widget (obrigatório em produção)
# ---------------------------------------------------------------------
# Endereço público deste sistema (sem barra no final). Ex.: https://suporte.seu-dominio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sites que podem mostrar o widget (separados por vírgula, sem barra no final). Vazio = qualquer site.
WIDGET_ALLOWED_ORIGINS=https://seu-dominio.com.br,https://app.seu-dominio.com.br
# Código do widget (o data-project do <script>). Deixe "principal", que já vem cadastrado no banco.
NEXT_PUBLIC_WIDGET_PROJECT_KEY=principal

# ---------------------------------------------------------------------
# Sua marca (opcional) — nome, logo e cor que aparecem no painel, no widget e nos e-mails
# ---------------------------------------------------------------------
# Nome da sua empresa ou produto.
NEXT_PUBLIC_BRAND_NAME=Sua Empresa
# Logo: arquivo dentro de /public (ex.: /logo.svg) ou endereço https completo. Pros e-mails, prefira PNG.
NEXT_PUBLIC_BRAND_LOGO_URL=/logo.svg
# Cor principal em hexadecimal (#rrggbb). A do widget também dá pra trocar no painel.
NEXT_PUBLIC_BRAND_COLOR=#7c3aed
# Seu site ou app (onde o widget está). Vira o botão "Falar com o suporte" no e-mail de encerramento.
NEXT_PUBLIC_BRAND_SITE_URL=https://seu-dominio.com.br

# ---------------------------------------------------------------------
# Segurança do widget (recomendado em produção)
# ---------------------------------------------------------------------
# Segredo pra assinar o e-mail do cliente (userHash = HMAC-SHA256 do e-mail). Gere com: openssl rand -hex 32
# O MESMO valor vai no servidor do seu site. Vazio = verificação desligada.
WIDGET_VERIFY_SECRET=
# "true" = recusa identify() sem userHash válido (ligue depois que o seu site já mandar o userHash).
WIDGET_REQUIRE_USER_HASH=false

# ---------------------------------------------------------------------
# Anexos (opcional)
# ---------------------------------------------------------------------
# Tamanho máximo por arquivo em MB (padrão 50, o limite do plano grátis do Supabase; máximo 400).
NEXT_PUBLIC_MAX_UPLOAD_MB=50
# Nome do bucket de anexos (o banco já cria "support-attachments"; só troque se renomear o bucket).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=support-attachments
SUPABASE_STORAGE_BUCKET=support-attachments

# ---------------------------------------------------------------------
# E-mail pelo Resend (opcional) — "Esqueci minha senha" e resumo ao encerrar atendimento
# ---------------------------------------------------------------------
# Chave da API do Resend (resend.com > API Keys). Vazio = sistema funciona sem e-mail.
RESEND_API_KEY=
# Remetente num domínio verificado no Resend. Ex.: suporte@seu-dominio.com.br
RESEND_FROM_EMAIL=
# Nome do remetente (padrão: "<sua marca> Suporte").
RESEND_FROM_NAME=
